{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond-prompting.example/registry/schemas/report.schema.json",
  "title": "Applicability report",
  "description": "Deterministic output of the applicability evaluator. The report is a pure function of the registry bytes, the selected profiles, the inventory bytes and the evaluation as-of date: no wall-clock time, no host inspection, no state. Status precedence per control: not_applicable (predicate false) over unsupported (version outside every verified range) over needs_decision (missing fact) over needs_decision (stale verification) over needs_decision (live conflict) over required/recommended (profile baseline).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_version", "registry_as_of", "as_of", "profiles", "inventory_digest", "registry_digest", "policy", "resolution", "results", "summary"],
  "properties": {
    "schema": {"const": "beyond-prompting/report@2"},
    "registry_version": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/version"},
    "registry_as_of": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/date"},
    "as_of": {
      "description": "The evaluation time supplied with the request. Staleness of a control's last verification is judged against this date, so it is always explicit in the report.",
      "$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/date"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/profile_id"}
    },
    "inventory_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "registry_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_verification_age_days"],
      "properties": {"max_verification_age_days": {"type": "integer", "minimum": 1, "maximum": 3650}}
    },
    "resolution": {
      "description": "Supersession resolutions performed while composing the evaluated control set.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "requested", "resolved_to"],
        "properties": {
          "profile": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/profile_id"},
          "requested": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/control_id"},
          "resolved_to": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/control_id"}
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control", "title", "status", "baseline", "profiles", "version_basis", "reasons"],
        "properties": {
          "control": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/control_id"},
          "title": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/short_string"},
          "status": {"enum": ["required", "recommended", "not_applicable", "needs_decision", "unsupported"]},
          "baseline": {"type": "boolean"},
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/profile_id"}
          },
          "version_basis": {
            "description": "Strongest evidence basis among the control's ranges containing the inventory Hermes version; out_of_range when the version is outside every range, unknown when the inventory omits the version. An in-range basis of documentation or illustrative is a disclosure, not exercised verification.",
            "enum": ["exercised", "documentation", "illustrative", "out_of_range", "unknown"]
          },
          "conflicts_with": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "https://beyond-prompting.example/registry/schemas/common.schema.json#/$defs/control_id"}
          },
          "reasons": {
            "description": "Every decision-relevant input that produced this status, each with an explicit source.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "detail"],
              "properties": {
                "source": {"enum": ["predicate.false", "predicate.fact_missing", "hermes_version.range", "hermes_version.basis", "verification.stale", "conflict.control", "profile.baseline", "profile.discretion"]},
                "detail": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "recommended", "not_applicable", "needs_decision", "unsupported", "total"],
      "properties": {
        "required": {"type": "integer", "minimum": 0},
        "recommended": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0},
        "needs_decision": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    }
  }
}
