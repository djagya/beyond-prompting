{
  "schema": "beyond-prompting/inventory@1",
  "deployment": {
    "kind": "workstation",
    "exposure": "loopback",
    "unattended_jobs": false,
    "owner_model": "individual"
  },
  "hermes": {"version": "1.1.0", "install": "git"},
  "platform": {"os": "linux", "containerized": false, "runs_as_root": false},
  "config": {
    "redact_secrets": true,
    "approvals_mode": "manual",
    "unattended_mode": "deny",
    "private_urls_blocked": true
  },
  "users": {"count": 1, "admins": 1}
}
